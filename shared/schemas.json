{
  "$defs": {
    "Action": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "Action",
      "type": "string"
    },
    "EngineMessage": {
      "additionalProperties": false,
      "description": "Envelope for every engine -> dashboard WebSocket message.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "enum": [
            "quote_update",
            "fair_value",
            "signal",
            "order",
            "fill",
            "position",
            "risk",
            "log",
            "health"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "ts",
        "data"
      ],
      "title": "EngineMessage",
      "type": "object"
    },
    "FairValue": {
      "additionalProperties": false,
      "description": "Our estimate of one contract's YES value.",
      "properties": {
        "exchange_id": {
          "title": "Exchange Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Weight given to each source; finite floats",
          "title": "Inputs",
          "type": "object"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "value": {
          "description": "Fair value, YES-denominated. Milli: price x 1000, so 0.537 -> 537. Float 0-1000; may be off-grid.",
          "maximum": 1000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "exchange_id",
        "value",
        "inputs",
        "model_version",
        "ts"
      ],
      "title": "FairValue",
      "type": "object"
    },
    "Fill": {
      "additionalProperties": false,
      "description": "Mirrors the API's Fill. `quantity` is signed: negative means NO shares.\n\n`price` is Bellwether's internal YES-denominated tick price. How REST and\nrealtime fill prices map onto it is decided by the future SIG client.",
      "properties": {
        "exchange_id": {
          "title": "Exchange Id",
          "type": "string"
        },
        "filled_at": {
          "format": "date-time",
          "title": "Filled At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "market_id": {
          "title": "Market Id",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Order Id"
        },
        "price": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Internal execution price, YES-denominated for both sides. Integer ticks: price x 200, so 0.005 -> 1, 0.5 -> 100, 0.995 -> 199. Integer 0-200. Not the API wire price; normalised at the API boundary.",
          "title": "Price"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "side": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "id",
        "order_id",
        "exchange_id",
        "market_id",
        "price",
        "quantity",
        "side",
        "filled_at"
      ],
      "title": "Fill",
      "type": "object"
    },
    "Lean": {
      "enum": [
        "D",
        "R",
        "none"
      ],
      "title": "Lean",
      "type": "string"
    },
    "Market": {
      "additionalProperties": false,
      "description": "One SIG market (one candidate's YES/NO contract within a race).",
      "properties": {
        "exchanges": {
          "description": "SIG exchange ids belonging to this market",
          "items": {
            "type": "string"
          },
          "title": "Exchanges",
          "type": "array"
        },
        "is_composite": {
          "title": "Is Composite",
          "type": "boolean"
        },
        "lean": {
          "$ref": "#/$defs/Lean",
          "default": "none"
        },
        "resolution_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copied from the market's Info tab",
          "title": "Resolution Text"
        },
        "settlement_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement Date"
        },
        "sig_market_id": {
          "title": "Sig Market Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "sig_market_id",
        "title",
        "exchanges",
        "is_composite"
      ],
      "title": "Market",
      "type": "object"
    },
    "MarketMapping": {
      "additionalProperties": false,
      "description": "Links one SIG exchange to the matching Polymarket and Kalshi contracts.",
      "properties": {
        "kalshi_ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kalshi Ticker"
        },
        "match_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Match Confidence",
          "type": "number"
        },
        "mismatch_notes": {
          "default": "",
          "title": "Mismatch Notes",
          "type": "string"
        },
        "polymarket_token_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polymarket Token Id"
        },
        "sig_exchange_id": {
          "title": "Sig Exchange Id",
          "type": "string"
        }
      },
      "required": [
        "sig_exchange_id",
        "match_confidence"
      ],
      "title": "MarketMapping",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "manual",
        "election"
      ],
      "title": "Mode",
      "type": "string"
    },
    "ModeCommand": {
      "additionalProperties": false,
      "description": "Body of POST /mode.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ModeCommand",
      "type": "object"
    },
    "OrderIntent": {
      "additionalProperties": false,
      "description": "An order we want to place. Must pass risk.check() before it is sent.\n\n`price` is the internal YES-denominated limit price, for YES and NO orders alike.\nIt is not the API request's `price`: the future SIG client must translate it at\nthe boundary, including any NO-side complement the API requires (unresolved).\n\n`price` is restricted to 1-199 ticks, so this model cannot carry a market-order\nprice (0, 200 or none). That alone does not guarantee limit-only execution; the\norder-sending code must still send a limit price derived from it.\n\nqty, idempotency_key and exchange_id follow the API's OrderInput constraints.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "exchange_id": {
          "description": "SIG exchange id: ASCII digits only.",
          "pattern": "^[0-9]+$",
          "title": "Exchange Id",
          "type": "string"
        },
        "idempotency_key": {
          "description": "Saved before sending; reused on retry. 1-255 characters.",
          "maxLength": 255,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "price": {
          "description": "Internal limit price, YES-denominated for both sides. Integer ticks: price x 200, so 0.005 -> 1, 0.5 -> 100, 0.995 -> 199. Integer 1-199. Not the API wire price; converted at the API boundary.",
          "maximum": 199,
          "minimum": 1,
          "title": "Price",
          "type": "integer"
        },
        "qty": {
          "description": "Whole shares, 1-2147483647.",
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Qty",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "idempotency_key",
        "exchange_id",
        "side",
        "action",
        "qty",
        "price",
        "reason"
      ],
      "title": "OrderIntent",
      "type": "object"
    },
    "OverrideCommand": {
      "additionalProperties": false,
      "description": "Body of POST /override. Expires after 15 minutes; still passes risk.check().",
      "properties": {
        "exchange_id": {
          "title": "Exchange Id",
          "type": "string"
        },
        "value": {
          "description": "Fair value set by hand, YES-denominated. Milli: price x 1000, so 0.537 -> 537. Float 0-1000.",
          "maximum": 1000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "exchange_id",
        "value"
      ],
      "title": "OverrideCommand",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "Mirrors the API's Position. `quantity` is signed: positive YES, negative NO.",
      "properties": {
        "avg_cost": {
          "title": "Avg Cost",
          "type": "number"
        },
        "current_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Price"
        },
        "exchange_id": {
          "title": "Exchange Id",
          "type": "string"
        },
        "market_id": {
          "title": "Market Id",
          "type": "string"
        },
        "market_title": {
          "title": "Market Title",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "settled": {
          "title": "Settled",
          "type": "boolean"
        },
        "unrealized_pnl": {
          "title": "Unrealized Pnl",
          "type": "number"
        }
      },
      "required": [
        "exchange_id",
        "market_id",
        "market_title",
        "settled",
        "quantity",
        "avg_cost",
        "current_price",
        "unrealized_pnl"
      ],
      "title": "Position",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "description": "Top of book from one venue, YES-denominated, in milli (price x 1000).\n\n`mid` is computed from bid and ask, never accepted as input. A plain dump\n(for the dashboard) includes it; a `round_trip=True` dump (for storage and\nreplay) omits it so the record validates back into a Quote.",
      "properties": {
        "ask": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Best ask, YES-denominated. Milli: price x 1000, so 0.537 -> 537. Integer 0-1000.",
          "title": "Ask"
        },
        "bid": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Best bid, YES-denominated. Milli: price x 1000, so 0.537 -> 537. Integer 0-1000.",
          "title": "Bid"
        },
        "exchange_id": {
          "title": "Exchange Id",
          "type": "string"
        },
        "mid": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Computed (bid + ask) / 2, YES-denominated. Milli: price x 1000, so 0.537 -> 537. May fall on a half milli. Output only: omitted by round_trip dumps and rejected as input.",
          "readOnly": true,
          "title": "Mid"
        },
        "source": {
          "$ref": "#/$defs/QuoteSource"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "source",
        "exchange_id",
        "bid",
        "ask",
        "ts",
        "mid"
      ],
      "title": "Quote",
      "type": "object"
    },
    "QuoteSource": {
      "enum": [
        "sig",
        "polymarket",
        "kalshi"
      ],
      "title": "QuoteSource",
      "type": "string"
    },
    "RiskLimits": {
      "additionalProperties": false,
      "description": "Limits for one mode. Values come from config/risk.yaml, never from code.",
      "properties": {
        "fair_value_max_age_s": {
          "exclusiveMinimum": 0,
          "title": "Fair Value Max Age S",
          "type": "number"
        },
        "max_order_susqies": {
          "exclusiveMinimum": 0,
          "title": "Max Order Susqies",
          "type": "number"
        },
        "max_race_pct": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Race Pct",
          "type": "number"
        },
        "max_scenario_loss_pct": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Scenario Loss Pct",
          "type": "number"
        },
        "min_cash_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Min Cash Pct",
          "type": "number"
        }
      },
      "required": [
        "max_race_pct",
        "max_order_susqies",
        "max_scenario_loss_pct",
        "fair_value_max_age_s",
        "min_cash_pct"
      ],
      "title": "RiskLimits",
      "type": "object"
    },
    "RiskState": {
      "additionalProperties": false,
      "properties": {
        "kill_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kill Reason"
        },
        "killed": {
          "title": "Killed",
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/RiskLimits"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "limits",
        "killed",
        "ts"
      ],
      "title": "RiskState",
      "type": "object"
    },
    "Side": {
      "enum": [
        "yes",
        "no"
      ],
      "title": "Side",
      "type": "string"
    },
    "Signal": {
      "additionalProperties": false,
      "description": "A strategy's suggestion. Logged whether or not it is traded.",
      "properties": {
        "edge_cents": {
          "title": "Edge Cents",
          "type": "number"
        },
        "exchange_id": {
          "title": "Exchange Id",
          "type": "string"
        },
        "reason": {
          "description": "Human-readable; shown on the dashboard",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "exchange_id",
        "strategy",
        "side",
        "edge_cents",
        "size",
        "reason",
        "ts"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "title": "Bellwether shared schemas"
}
